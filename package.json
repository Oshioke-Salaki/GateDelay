  "version": "0.0.0",
  "engines": {
    "node": "20.19.0",
    "npm": "10.8.2"
  },
  "packageManager": "npm@10.8.2",
  "toolchain": {
    "node": "20.19.0",
    "npm": "10.8.2",
    "foundry": "1.1.0",
