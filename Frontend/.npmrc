# `@react-pdf/renderer@3.x` still declares its React peer as ^16 || ^17 || ^18,
# while this app is on React 19. npm 7+ treats that as a hard resolution error,
# so `npm ci` fails even though the committed lockfile is valid and the package
# works at runtime. This keeps `npm install`, `npm ci` and the Docker build
# resolving identically.
# Remove it once @react-pdf/renderer is on 4.x, which supports React 19.
legacy-peer-deps=true

# Enforce the `engines` field in package.json (node >= 20, npm >= 10).
engine-strict=true
