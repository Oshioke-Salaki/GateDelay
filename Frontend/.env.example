# -----------------------------------------------------------------------------
# Frontend environment (Next.js)
# -----------------------------------------------------------------------------
# Copy to `.env.local` for development, or pass these as build args to the
# Docker image (see docs/DEPLOY_FRONTEND_DOCKER.md).
#
# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  SECURITY WARNING — READ BEFORE ADDING NEW VARIABLES                    ║
# ╠══════════════════════════════════════════════════════════════════════════╣
# ║  Every key prefixed NEXT_PUBLIC_ is inlined into the client-side        ║
# ║  JavaScript bundle at BUILD TIME by the Next.js compiler.               ║
# ║                                                                         ║
# ║  This means the value is:                                               ║
# ║    • shipped to every visitor's browser                                 ║
# ║    • visible in plain text in DevTools → Sources / Network              ║
# ║    • present in the compiled output on your CDN / container image       ║
# ║                                                                         ║
# ║  NEVER put the following here:                                          ║
# ║    ✗  Private keys or wallet seeds                                      ║
# ║    ✗  JWT secrets or signing keys                                       ║
# ║    ✗  Database connection strings                                       ║
# ║    ✗  Internal service URLs that must stay private                      ║
# ║    ✗  Third-party API keys with write/billing access (e.g. the full     ║
# ║       AviationStack key — use the Backend proxy instead)                ║
# ║    ✗  Any credential that grants elevated permissions                   ║
# ║                                                                         ║
# ║  NEXT_PUBLIC_ variables are CONFIGURATION, not secrets.                 ║
# ║  Secrets belong in Backend/.env (see Backend/.env.example) and are      ║
# ║  only ever read server-side.                                            ║
# ╚══════════════════════════════════════════════════════════════════════════╝
#
# Only `.env.example` is committed. `.gitignore` excludes every other
# `.env*` file in this directory.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Backend API — required
# -----------------------------------------------------------------------------
# Base URL of the NestJS API, including the global /api prefix set in
# Backend/src/main.ts. Read by the route handlers under app/api/*, which proxy
# the browser to the backend so the real origin is never exposed client-side.
#
# Build-time client variable — safe to contain a public hostname only.
# Do NOT put auth tokens or passwords in this URL.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Base URL used by direct (non-proxied) browser calls and the socket.io client.
# Same rules: hostname/port only, no credentials.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Wallet / Particle ConnectKit — required for wallet connect
# -----------------------------------------------------------------------------
# These are publishable (client-safe) keys issued by Particle Network.
# They identify your app to the Particle dashboard but do not grant write
# access to funds or admin APIs.  They are intentionally public.
#
# When PROJECT_ID, CLIENT_KEY and APP_ID are all absent, ParticleProvider
# mounts its children unwrapped and the app runs without wallet connect.
# That is a supported local mode: the rest of the UI (including /audit) works.
NEXT_PUBLIC_PROJECT_ID=
NEXT_PUBLIC_CLIENT_KEY=
NEXT_PUBLIC_APP_ID=

# Optional: enables the WalletConnect connector (publishable project ID).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# -----------------------------------------------------------------------------
# On-chain addresses — optional; features degrade gracefully without them
# -----------------------------------------------------------------------------
# Contract addresses are public by definition (visible on-chain).
# They are safe to include here.
NEXT_PUBLIC_MARKET_FACTORY_ADDRESS=
NEXT_PUBLIC_MARKET_MAKER_ADDRESS=
NEXT_PUBLIC_GOVERNANCE_CONTRACT_ADDRESS=
NEXT_PUBLIC_GOVERNANCE_TOKEN_ADDRESS=
NEXT_PUBLIC_VOTING_CONTRACT_ADDRESS=

# Optional JSON produced by Contracts/script/WriteDeploymentRegistry.s.sol.
# Contains only addresses — no private keys.  Do NOT commit the generated file.
NEXT_PUBLIC_DEPLOYMENT_REGISTRY_JSON=

# -----------------------------------------------------------------------------
# Third-party endpoints — optional
# -----------------------------------------------------------------------------
# Public IPFS gateway URL (read-only, no auth token).
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# BROWSER-SAFE key only — this must be a read-only / free-tier key.
# The billable AviationStack key belongs in Backend/.env as
# AVIATION_STACK_API_KEY and is proxied server-side so it is never exposed.
NEXT_PUBLIC_AVIATION_STACK_KEY=
