# -----------------------------------------------------------------------------
# Frontend environment (Next.js)
# -----------------------------------------------------------------------------
# Copy to `.env.local` for development, or pass these as build args to the
# Docker image (see docs/DEPLOY_FRONTEND_DOCKER.md).
#
# IMPORTANT: every key below is prefixed `NEXT_PUBLIC_`, which means Next.js
# INLINES IT INTO THE CLIENT BUNDLE AT BUILD TIME. Anything here is shipped to
# every visitor and is readable in devtools. It is therefore a *configuration*
# file, never a secret store.
#
#   - Never put a private key, JWT secret, database URL or provider secret here.
#     Those belong in Backend/.env (see Backend/.env.example) and must only ever
#     be read server-side.
#   - Only `.env.example` is committed. `.gitignore` excludes every other
#     `.env*` file in this directory.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Backend API — required
# -----------------------------------------------------------------------------
# Base URL of the NestJS API, including the global `/api` prefix set in
# Backend/src/main.ts. Read by the route handlers under app/api/*, which proxy
# the browser to the backend.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Base URL used by direct (non-proxied) browser calls and the socket.io client.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Wallet / Particle ConnectKit — required for wallet connect
# -----------------------------------------------------------------------------
# When PROJECT_ID, CLIENT_KEY and APP_ID are all absent, ParticleProvider mounts
# its children unwrapped and the app runs without wallet connect. That is a
# supported local mode: the rest of the UI, including /audit, still works.
NEXT_PUBLIC_PROJECT_ID=
NEXT_PUBLIC_CLIENT_KEY=
NEXT_PUBLIC_APP_ID=

# Optional: enables the WalletConnect connector.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# -----------------------------------------------------------------------------
# On-chain addresses — optional; features degrade without them
# -----------------------------------------------------------------------------
NEXT_PUBLIC_MARKET_FACTORY_ADDRESS=
NEXT_PUBLIC_MARKET_MAKER_ADDRESS=
NEXT_PUBLIC_GOVERNANCE_CONTRACT_ADDRESS=
NEXT_PUBLIC_GOVERNANCE_TOKEN_ADDRESS=
NEXT_PUBLIC_VOTING_CONTRACT_ADDRESS=

# -----------------------------------------------------------------------------
# Third-party endpoints — optional
# -----------------------------------------------------------------------------
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Public/browser-safe key only. A billable AviationStack key belongs in
# Backend/.env as AVIATION_STACK_API_KEY, proxied through the backend.
NEXT_PUBLIC_AVIATION_STACK_KEY=
