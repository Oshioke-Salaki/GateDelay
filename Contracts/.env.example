# =============================================================================
# GateDelay – Deployment Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit a .env file with real private keys or credentials.
#
# Load before running forge scripts:
#   source .env
#   forge script script/Deploy<Name>.s.sol:<Contract> --rpc-url $RPC_URL --broadcast
# =============================================================================


# -----------------------------------------------------------------------------
# UNIVERSAL (required by every deploy script)
# -----------------------------------------------------------------------------

# Deployer private key — hex, 0x-prefixed.
PRIVATE_KEY="0xYOUR_DEPLOYER_PRIVATE_KEY"

# RPC endpoint passed to forge via --rpc-url.
# The scripts themselves read env vars through vm.env*; they do NOT read RPC_URL.
RPC_URL="https://YOUR_NETWORK_RPC_URL"


# -----------------------------------------------------------------------------
# DeployCoreMarket / DeployCoreMarketWithFeeHandler / DeployFullStack
# -----------------------------------------------------------------------------

# Address of a deployed ERC-20 token used as market collateral.
# Must have deployed contract code (the script validates this).
COLLATERAL_TOKEN_ADDRESS="0xYOUR_COLLATERAL_TOKEN_ADDRESS"

# Address that receives the commission portion of every trade fee.
COMMISSION_RECIPIENT="0xYOUR_COMMISSION_RECIPIENT_ADDRESS"

# Total trading fee charged on each buy, in basis points (1 bps = 0.01%).
# Max 1000 (= 10%). Default: 30 (= 0.3%).
TRADING_FEE_BPS="30"

# Portion of the trading fee paid back to the taker's referrer, in basis points.
# Must be ≤ TRADING_FEE_BPS. Default: 0.
TRADING_REBATE_BPS="0"


# -----------------------------------------------------------------------------
# DeployFeeHandler / DeployFeeHandlerWithSetup / DeployFullStack
# (FeeHandler initial TRADING structure)
# -----------------------------------------------------------------------------

# Fee rate for the FeeHandler's TRADING structure, in basis points. Max 1000.
# When omitted in DeployFullStack, defaults to TRADING_FEE_BPS.
FEE_BPS="30"

# Up to three fee recipients whose FEE_RECIPIENT_*_SHARE_BPS values must sum
# to exactly 10000. If FEE_RECIPIENT_1 is omitted, the deployer receives 100%.

# Recipient 1 (required when configuring a fee structure)
FEE_RECIPIENT_1="0xYOUR_FEE_RECIPIENT_1_ADDRESS"
FEE_RECIPIENT_1_SHARE_BPS="10000"

# Recipient 2 (optional — include only when splitting fees)
#FEE_RECIPIENT_2="0xYOUR_FEE_RECIPIENT_2_ADDRESS"
#FEE_RECIPIENT_2_SHARE_BPS="5000"

# Recipient 3 (optional — include only when splitting fees three ways)
#FEE_RECIPIENT_3="0xYOUR_FEE_RECIPIENT_3_ADDRESS"
#FEE_RECIPIENT_3_SHARE_BPS="2000"

# keccak256 label for the fee structure (default: "TRADING").
# Change only if you need a non-standard structure key.
#FEE_STRUCTURE_ID="TRADING"


# -----------------------------------------------------------------------------
# DeployRoleManager / DeployRoleManagerWithSetup / DeployFullStack
# (standard protocol roles)
# -----------------------------------------------------------------------------

# Set any of the flags below to "true" to create that role at deploy time.
# Roles are registered via RoleManager.createRole() inside the broadcast.
ROLE_MARKET_ADMIN="true"
ROLE_RESOLVER="true"
ROLE_OPERATOR="true"
ROLE_PAUSER="true"

# Addresses to receive each role immediately after creation.
# Leave blank (or omit) to create the role without assigning it yet.
ROLE_MARKET_ADMIN_ASSIGNEE="0xYOUR_MARKET_ADMIN_ADDRESS"
ROLE_RESOLVER_ASSIGNEE="0xYOUR_RESOLVER_ADDRESS"
ROLE_OPERATOR_ASSIGNEE="0xYOUR_OPERATOR_ADDRESS"
ROLE_PAUSER_ASSIGNEE="0xYOUR_PAUSER_ADDRESS"


# -----------------------------------------------------------------------------
# DeployCircuitBreaker / DeployCircuitBreakerWithSetup / DeployFullStack
# (CircuitBreaker role delegation)
# -----------------------------------------------------------------------------

# Service account granted BREAKER_ROLE (can call triggerBreak / attemptRecovery).
# Leave blank to keep only the deployer in that role.
CB_BREAKER_ADDRESS="0xYOUR_BREAKER_SERVICE_ADDRESS"

# Service account granted MONITOR_ROLE (can call recordSuccess / recordFailure).
# Leave blank to keep only the deployer in that role.
CB_MONITOR_ADDRESS="0xYOUR_MONITOR_SERVICE_ADDRESS"

# Set to "true" to strip BREAKER_ROLE from the deployer after granting it to
# CB_BREAKER_ADDRESS. Requires CB_BREAKER_ADDRESS to be set.
CB_REVOKE_DEPLOYER_BREAKER="false"

# Set to "true" to strip MONITOR_ROLE from the deployer after granting it to
# CB_MONITOR_ADDRESS. Requires CB_MONITOR_ADDRESS to be set.
CB_REVOKE_DEPLOYER_MONITOR="false"


# -----------------------------------------------------------------------------
# DeployCircuitBreaker / DeployCircuitBreakerWithSetup / DeployFullStack
# (CircuitBreaker configuration — all optional, shown with constructor defaults)
# -----------------------------------------------------------------------------

# Absolute number of recorded failures before the circuit trips to Open.
# Must be > 0. Default: 5.
#CB_FAILURE_THRESHOLD="5"

# Failure rate percentage (failures / total ops * 100) that trips the circuit.
# Must be 1–100. Default: 50.
#CB_FAILURE_RATE_THRESHOLD="50"

# Seconds that must elapse after a trip before attemptRecovery() is allowed.
# Must be > 0. Default: 3600 (1 hour).
#CB_RECOVERY_TIMEOUT="3600"

# Rolling window in seconds used to assess system health.
# Must be > 0. Default: 86400 (24 hours).
#CB_HEALTH_CHECK_WINDOW="86400"


# -----------------------------------------------------------------------------
# Verification scripts (read-only, no broadcast)
# -----------------------------------------------------------------------------

# DeployRoleManager / VerifyRoleManager
ROLE_MANAGER_ADDRESS="0xDEPLOYED_ROLE_MANAGER_ADDRESS"

# DeployFeeHandler / VerifyFeeHandler
FEE_HANDLER_ADDRESS="0xDEPLOYED_FEE_HANDLER_ADDRESS"

# DeployCircuitBreaker / VerifyCircuitBreaker
CIRCUIT_BREAKER_ADDRESS="0xDEPLOYED_CIRCUIT_BREAKER_ADDRESS"

# DeployCoreMarket / VerifyCoreMarket
MARKET_MAKER_ADDRESS="0xDEPLOYED_MARKET_MAKER_ADDRESS"
TRADING_ADDRESS="0xDEPLOYED_TRADING_ADDRESS"


# -----------------------------------------------------------------------------
# Other scripts (pre-existing)
# -----------------------------------------------------------------------------

# DeployMarketMinter
TOKEN_ADDRESS="0xYOUR_TOKEN_ADDRESS"

# DeployVoteWeight / VerifyVoteWeight
GOVERNANCE_TOKEN="0xYOUR_GOVERNANCE_TOKEN_ADDRESS"
VOTEWEIGHT_ADDRESS="0xDEPLOYED_VOTEWEIGHT_ADDRESS"

# WriteDeploymentRegistry
REGISTRY_CHAIN_ID="1"
REGISTRY_ABI_VERSION="1"
MARKET_SETTLEMENT_ADDRESS="0xDEPLOYED_MARKET_SETTLEMENT_ADDRESS"
RESOLUTION_ADDRESS="0xDEPLOYED_RESOLUTION_ADDRESS"
MARKET_BRIDGE_ADDRESS="0xDEPLOYED_MARKET_BRIDGE_ADDRESS"
MARKET_MINTER_ADDRESS="0xDEPLOYED_MARKET_MINTER_ADDRESS"
MARKET_WITHDRAW_ADDRESS="0xDEPLOYED_MARKET_WITHDRAW_ADDRESS"

# DeployRevokeFunctionTestnet (optional demo accounts)
DEMO_ADMIN="0xYOUR_DEMO_ADMIN_ADDRESS"
DEMO_USER1="0xYOUR_DEMO_USER1_ADDRESS"
DEMO_USER2="0xYOUR_DEMO_USER2_ADDRESS"
