# Deployment signer. Never commit a real private key or source this file with
# production credentials.
PRIVATE_KEY="0xYOUR_DEPLOYER_PRIVATE_KEY"

# Pass this value to forge with --rpc-url; the deployment script reads
# PRIVATE_KEY through vm.envUint and does not read RPC_URL itself.
RPC_URL="https://YOUR_NETWORK_RPC_URL"

# Optional values used by DeployRevokeFunctionTestnet.
DEMO_ADMIN="0xYOUR_DEMO_ADMIN_ADDRESS"
DEMO_USER1="0xYOUR_DEMO_USER1_ADDRESS"
DEMO_USER2="0xYOUR_DEMO_USER2_ADDRESS"