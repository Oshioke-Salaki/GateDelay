    "@nestjs/websockets": "^11.1.19",
    "@tensorflow/tfjs": "^4.22.0",
    "agenda": "^5.0.0",
    "archiver": "^8.0.0",
    "async": "^3.2.6",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.15.2",
    "bcrypt": "^6.0.0",
    "big.js": "^6.2.2",
    "bip39": "^3.1.0",
    "bull": "^4.16.4",
    "cache-manager": "^7.2.8",
    "cache-manager-ioredis-yet": "^2.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.6",
    "d3": "^6.7.0",
    "ethers": "^6.16.0",
