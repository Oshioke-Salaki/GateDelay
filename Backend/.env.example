# -----------------------------------------------------------------------------
# Core app
# -----------------------------------------------------------------------------
# Required in most environments.
PORT=4000
# NODE_ENV also selects the deploy target for scripts/deploy.js:
#   staging  -> k8s namespace "staging", config/deploy.staging.json
#   production-> k8s namespace "prod",    config/deploy.production.json
# See .github/workflows/README.md. Registry/kubectl credentials for a real
# deploy come from CI secrets, never this file.
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Image tag used by scripts/deploy.js; CI passes the git SHA instead.
APP_VERSION=local

# -----------------------------------------------------------------------------
# Auth and webhook secrets
# -----------------------------------------------------------------------------
# Required: replace all placeholders before deploying.
JWT_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_second_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
WEBHOOK_SECRET=replace_with_webhook_secret
BETA_INVITE_SECRET=replace_with_beta_invite_secret
EXPORT_ENCRYPTION_KEY=replace_with_export_encryption_key

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
# Required for API features and most background services.
MONGODB_URI=mongodb://127.0.0.1:27017/gatedelay

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Required if you use queues, throttling, alerts, or sync workers.
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DDOS_DB=5
REDIS_THROTTLE_DB=6

# -----------------------------------------------------------------------------
# Flight and AI providers
# -----------------------------------------------------------------------------
# Required for live flight data and AI-driven analysis.
AVIATION_STACK_API_KEY=replace_with_aviationstack_key
GROQ_API_KEY=replace_with_groq_api_key

# -----------------------------------------------------------------------------
# RPC and signer configuration
# -----------------------------------------------------------------------------
# Use RPC_URL for generic services and BLOCKCHAIN_RPC_URL for the oracle route.
RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_RPC_URL=https://rpc.mantle.xyz
BLOCKCHAIN_CHAIN_ID=5000
ETH_PROVIDER_URL=https://cloudflare-eth.com
PRIVATE_KEY=replace_with_deployer_or_operator_private_key
MARKET_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# -----------------------------------------------------------------------------
# Chain-specific backend integrations
# -----------------------------------------------------------------------------
# Optional: network.service.ts will fall back to public defaults when missing.
MAINNET_RPC_URL=
MAINNET_MARKET_ADDRESS=
MAINNET_TRADING_ADDRESS=
MAINNET_LIQUIDITY_ADDRESS=
MAINNET_COLLATERAL_ADDRESS=

TESTNET_RPC_URL=
TESTNET_MARKET_ADDRESS=
TESTNET_TRADING_ADDRESS=
TESTNET_LIQUIDITY_ADDRESS=
TESTNET_COLLATERAL_ADDRESS=

POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_MARKET_ADDRESS=
POLYGON_TRADING_ADDRESS=
POLYGON_LIQUIDITY_ADDRESS=
POLYGON_COLLATERAL_ADDRESS=

# -----------------------------------------------------------------------------
# Observability and operational controls
# -----------------------------------------------------------------------------
LOG_LEVEL=info
RATE_LIMIT_WHITELIST=
HEARTBEAT_PORT=4001

# -----------------------------------------------------------------------------
# Email and notifications
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@gatedelay.com

# Optional — only required for on-call/incident alerting (Backend/services/pagerduty.js).
# Left unset, the app boots normally; alert calls will fail until these are set.
PAGERDUTY_API_KEY=
PAGERDUTY_SERVICE_ID=
PAGERDUTY_FROM_EMAIL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# -----------------------------------------------------------------------------
# IPFS / Pinata
# -----------------------------------------------------------------------------
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
IPFS_NODE_URL=https://ipfs.infura.io:5001/api/v0
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Beta access — HMAC secret for invite token hashing (keep strong in production)
BETA_INVITE_SECRET=your_beta_invite_secret_here

# Approval workflows — cron-based expiry check (only "true" enables it)
APPROVAL_CRON_ENABLED=false

# Firebase (push notifications — paste the service account JSON as a single line)
# -----------------------------------------------------------------------------
# Optional third-party services
# -----------------------------------------------------------------------------
ETHERSCAN_API_KEY=
FIREBASE_SERVICE_ACCOUNT=
